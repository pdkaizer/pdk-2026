{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npm-run-all --parallel dev:*",
    "dev:11ty": "eleventy --serve",
    "dev:css": "postcss src/assets/css/main.css -o _site/assets/css/main.css --watch",
    "build": "npm-run-all build:css build:11ty build:search",
    "build:css": "postcss src/assets/css/main.css -o _site/assets/css/main.css",
    "build:11ty": "eleventy",
    "build:search": "pagefind --site _site"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "npm-run-all2": "^6.0.0",
    "pagefind": "^1.5.2",
    "postcss": "^8.0.0",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.0.0",
    "postcss-nesting": "^13.0.0"
  },
  "dependencies": {
    "@11ty/eleventy-fetch": "^5.1.3",
    "rss-parser": "^3.13.0"
  }
}
