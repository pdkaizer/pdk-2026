---
layout: layouts/base.njk
title: Home
ogImage: /assets/images/work/modern-we-starter.png
---
<div class="l-wrapper">
  <section class="hero">
    <p class="hero__eyebrow">Product Designer</p>
    <h1 class="hero__headline">Design that shapes how people think and act.</h1>
    <p class="hero__body">
      I am a digital product designer with a passion for user focused digital products that are highly functional and beautifully designed. Currently exploring the ways AI can meaningfully enhance <strong>human centered design</strong> work.
    </p>
    <div class="hero__actions">
      <a href="/work/" class="btn btn--primary">View my work</a>
      <a href="/about/" class="btn btn--secondary">About me</a>
    </div>
  </section>
</div>

{% if designBytes | length %}
<section class="l-wrapper l-section">
  <div class="section-header">
    <p class="section-label">Featured article</p>
    <a href="https://design-bytes.com" class="btn btn--secondary" target="_blank" rel="noopener">
      Visit Design Bytes
    </a>
  </div>

  {% set post = designBytes[0] %}
  <a class="post-card post-card--featured" href="{{ post.url }}" target="_blank" rel="noopener">
    {% if post.image %}
      <div class="post-card__image">
        <img src="{{ post.image }}" alt="{{ post.title }}" loading="lazy" />
      </div>
    {% else %}
      <div class="post-card__image post-card__image--placeholder"></div>
    {% endif %}
    <div class="post-card__body">
      {% if post.date %}
        <time class="post-card__date" datetime="{{ post.date | htmlDateString }}">
          {{ post.date | readableDate }}
        </time>
      {% endif %}
      <h2 class="post-card__title">{{ post.title }}</h2>
      {% if post.summary %}
        <p class="post-card__summary">{{ post.summary }}</p>
      {% endif %}
    </div>
  </a>
</section>
{% endif %}

{% if collections.thoughts | length %}
<section class="l-wrapper l-section">
  <div class="section-header">
    <p class="section-label">Recent Design Thoughts</p>
    <a href="/thoughts/" class="btn btn--secondary">All thoughts</a>
  </div>

  <div class="thoughts-grid">
    {% for thought in collections.thoughts | limit(3) %}
      <a class="thought-card" href="{{ thought.url }}" data-category="{{ thought.data.category | lower }}">
        <span class="thought-card__category">{{ thought.data.category }}</span>
        <h2 class="thought-card__title">{{ thought.data.title }}</h2>
        <p class="thought-card__description">{{ thought.data.description }}</p>
        {% if thought.data.tags and thought.data.tags | length %}
          <div class="thought-card__tags">
            {% for tag in thought.data.tags %}
              <span class="tag">{{ tag }}</span>
            {% endfor %}
          </div>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if collections.caseStudies | length %}
<section class="l-wrapper l-section">
  <div class="section-header">
    <p class="section-label">Selected work</p>
    <a href="/work/" class="btn btn--secondary">All projects</a>
  </div>

  <div class="l-grid">
    {% for project in collections.caseStudies | limit(2) %}
      {% set project = project %}
      {% include "components/project-card.njk" %}
    {% endfor %}
  </div>
</section>
{% endif %}

{% if collections.photoGalleries | length %}
<section class="l-wrapper l-section">
  <div class="section-header">
    <p class="section-label">Selected photos</p>
    <a href="/photos/" class="btn btn--secondary">All galleries</a>
  </div>

  <div class="l-grid">
    {% for gallery in collections.photoGalleries | limit(1) %}
      <a class="gallery-card" href="{{ gallery.url }}">
        <div class="gallery-card__image">
          {% if gallery.data.cover %}
            <img
              src="{{ gallery.data.cover }}"
              alt="{{ gallery.data.cover_alt or gallery.data.title }}"
              loading="lazy"
            />
          {% endif %}
          <span class="gallery-card__count">
            {{ gallery.data.photos | length }} photo{% if gallery.data.photos | length != 1 %}s{% endif %}
          </span>
        </div>
        <div class="gallery-card__meta">
          <h2 class="gallery-card__title">{{ gallery.data.title }}</h2>
          {% if gallery.data.location %}
            <p class="gallery-card__location">{{ gallery.data.location }}</p>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</section>
{% endif %}
