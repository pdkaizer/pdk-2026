---
layout: layouts/base.njk
title: Contact
description: Get in touch.
permalink: /contact/
---
<div class="l-wrapper l-section">
  <div class="l-stack">
    <p class="section-label">Contact</p>
    <h1>Let's talk</h1>
    <p class="hero__body">
      Have a project in mind, want to collaborate, or just want to say hello?
      Send me a message — I'll get back to you within a day or two.
    </p>
  </div>

  <hr class="divider" />

  <form class="contact-form" name="contact" method="POST" action="/thanks/" netlify
    toolname="contact_peter_kaizer"
    tooldescription="Send a message to Peter Kaizer, a product designer, through his portfolio contact form. Use for project inquiries, job opportunities, collaboration or questions about his work.">
    <div class="form-field">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" autocomplete="name" required
        toolparamdescription="Full name of the person sending the message." />
    </div>

    <div class="form-field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" autocomplete="email" required
        toolparamdescription="Email address Peter should reply to." />
    </div>

    <div class="form-field">
      <label for="message">Message</label>
      <textarea id="message" name="message" rows="6" required
        toolparamdescription="The message to Peter: who you are and what you would like to discuss."></textarea>
    </div>

    <button type="submit" class="btn btn--primary">Send message</button>
  </form>
</div>
