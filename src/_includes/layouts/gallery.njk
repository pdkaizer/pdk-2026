---
layout: layouts/base.njk
---
<div class="l-wrapper gallery-hero-wrap">
  <header class="gallery-hero{% if lat and lng %} gallery-hero--with-map{% endif %}">
    <div class="gallery-hero__text">
      <a href="/photos/" class="gallery-back">← All galleries</a>
      <h1 class="gallery-hero__title">{{ title }}</h1>
      {% if description %}
        <p class="gallery-hero__description">{{ description }}</p>
      {% endif %}
      <div class="gallery-hero__meta">
        {% if location %}
          <span>{{ location }}</span>
        {% endif %}
        {% if date %}
          <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
        {% endif %}
      </div>
    </div>
    {% if lat and lng and site.mapboxToken %}
      <div
        class="gallery-hero__map"
        id="gallery-map"
        data-lat="{{ lat }}"
        data-lng="{{ lng }}"
        data-token="{{ site.mapboxToken }}"
        role="region"
        aria-label="Map showing {{ location or title }}"
      ></div>
    {% endif %}
  </header>
</div>

{% if photos | length %}
  <div class="l-wrapper">
    <div class="photo-grid">
      {% for photo in photos %}
        <figure class="photo-grid__item">
          <button type="button" class="photo-grid__trigger" data-lightbox-trigger data-src="{{ photo.src }}" data-alt="{{ photo.alt or '' }}" data-caption="{{ photo.caption or '' }}" aria-label="View enlarged photo">
            <img
              src="{{ photo.src }}"
              alt="{{ photo.alt or '' }}"
              loading="lazy"
              decoding="async"
            />
          </button>
          {% if photo.caption %}
            <figcaption>{{ photo.caption }}</figcaption>
          {% endif %}
        </figure>
      {% endfor %}
    </div>
  </div>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Enlarged photo" inert>
    <button type="button" class="lightbox__close" id="lightbox-close" aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <img class="lightbox__image" id="lightbox-image" src="" alt="" />
    <p class="lightbox__caption" id="lightbox-caption"></p>
  </div>
{% endif %}

{% if content | trim %}
  <div class="l-wrapper l-prose prose" style="margin-block-top: var(--space-16);">
    {{ content | safe }}
  </div>
{% endif %}
