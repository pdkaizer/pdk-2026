---
layout: layouts/base.njk
---
<article>
  <div class="l-wrapper">
    <header class="case-study-hero">
      <div class="case-study-hero__text">
        {% if category %}
          <p class="case-study-hero__category">{{ category }}</p>
        {% endif %}
        <h1 class="case-study-hero__title">{{ title }}</h1>
        {% if summary %}
          <p class="case-study-hero__summary">{{ summary }}</p>
        {% endif %}
      </div>
      {% if hero_portrait %}
        <figure class="case-study-hero__image">
          <img src="{{ hero_portrait }}" alt="{{ hero_portrait_alt or title }}" />
        </figure>
      {% endif %}
    </header>

  </div>

  {% if hero_image %}
    <div class="l-wrapper">
      <figure class="case-study-image">
        <img src="{{ hero_image }}" alt="{{ hero_image_alt or title }}"{% if hero_image_width %} width="{{ hero_image_width }}"{% endif %}{% if hero_image_height %} height="{{ hero_image_height }}"{% endif %} />
      </figure>
    </div>
  {% endif %}

  {% if project_url %}
    <div class="l-wrapper">
      <a class="btn" href="{{ project_url }}" target="_blank" rel="noopener noreferrer">{{ project_url | replace("https://", "") | replace("http://", "") }}</a>
    </div>
  {% endif %}

  <div class="l-wrapper">
    <dl class="case-study-meta">
      {% if role %}
        <div class="case-study-meta__item">
          <dt>Role</dt>
          <dd>{{ role }}</dd>
        </div>
      {% endif %}
      {% if year %}
        <div class="case-study-meta__item">
          <dt>Year</dt>
          <dd>{{ year }}</dd>
        </div>
      {% endif %}
      {% if company %}
        <div class="case-study-meta__item">
          <dt>Company</dt>
          <dd>{{ company }}</dd>
        </div>
      {% endif %}
      {% if tags and tags | length %}
        <div class="case-study-meta__item">
          <dt>Disciplines</dt>
          <dd>{{ tags | join(", ") }}</dd>
        </div>
      {% endif %}
    </dl>
  </div>

  <div class="l-wrapper">
    <div class="prose">
      {{ content | safe }}
    </div>
  </div>
</article>
