---
layout: layouts/base.njk
---
<article>
  <div class="l-wrapper">
    <a href="/thoughts/" class="thought-back">&#8592; Thoughts</a>
    <header class="thought-hero">
      <div class="thought-hero__text">
        {% if category %}
          <p class="thought-hero__category" data-category="{{ category | lower }}">{{ category }}</p>
        {% endif %}
        <h1 class="thought-hero__title">{{ title }}</h1>
        {% if description %}
          <p class="thought-hero__description">{{ description }}</p>
        {% endif %}
      </div>
    </header>
  </div>

  {% set shareUrl = page.url | absoluteUrl(site.url) %}
  <div class="l-wrapper">
    <dl class="thought-meta">
      {% if date %}
        <div class="thought-meta__item">
          <dt>Published</dt>
          <dd>{{ date | readableDate }}</dd>
        </div>
      {% endif %}
      {% if tags and tags | length %}
        <div class="thought-meta__item">
          <dt>Topics</dt>
          <dd>{{ tags | join(", ") }}</dd>
        </div>
      {% endif %}
    </dl>
  </div>

  <div class="l-wrapper">
    <div class="prose">
      {{ content | safe }}
    </div>

    <div class="thought-share">
      <a class="btn btn--secondary" href="https://bsky.app/intent/compose?text={{ (title ~ " " ~ shareUrl) | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Bluesky">
        Share to: <i class="fa-brands fa-bluesky" aria-hidden="true"></i>
      </a>
      <button type="button" class="btn btn--secondary" data-mastodon-share data-share-text="{{ title }}" data-share-url="{{ shareUrl }}" aria-label="Share on Mastodon">
        Share to: <i class="fa-brands fa-mastodon" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</article>
