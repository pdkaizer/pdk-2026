---
layout: layouts/base.njk
title: Thoughts
permalink: /thoughts/
---
<div class="l-wrapper">
  <header class="l-section">
    <p class="section-label">Thoughts</p>
    <h1 class="section-title--sm">Short thoughts on design craft</h1>
    <p class="thoughts-page-description">Compact explorations — a concept, a principle, or an observation worth sitting with.</p>
  </header>

  <div class="thoughts-grid">
    {% for thought in collections.thoughts %}
      <a class="thought-card" href="{{ thought.url }}" data-category="{{ thought.data.category | lower }}">
        <span class="thought-card__category">{{ thought.data.category }}</span>
        <h2 class="thought-card__title">{{ thought.data.title }}</h2>
        <p class="thought-card__description">{{ thought.data.description }}</p>
        {% if thought.data.tags and thought.data.tags | length %}
          <div class="thought-card__tags">
            {% for tag in thought.data.tags %}
              <span class="tag">{{ tag }}</span>
            {% endfor %}
          </div>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</div>
