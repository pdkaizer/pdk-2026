---
layout: layouts/base.njk
title: Writing
description: Thoughts on product design, process, and craft.
permalink: /writing/
---
<div class="l-wrapper l-section">
  <div class="l-stack">
    <p class="section-label">Writing</p>
    <h1>Thoughts on design</h1>
  </div>

  <hr class="divider" />

  {% if collections.writing | length %}
    <div class="l-grid">
      {% for post in collections.writing %}
        <a class="post-card" href="{{ post.url }}">
          {% if post.data.thumbnail %}
            <div class="post-card__image">
              <img src="{{ post.data.thumbnail }}" alt="{{ post.data.title }}" loading="lazy" />
            </div>
          {% else %}
            <div class="post-card__image post-card__image--placeholder"></div>
          {% endif %}
          <div class="post-card__body">
            <time class="post-card__date" datetime="{{ post.date | htmlDateString }}">
              {{ post.date | readableDate }}
            </time>
            <h2 class="post-card__title">{{ post.data.title }}</h2>
            {% if post.data.summary %}
              <p class="post-card__summary">{{ post.data.summary }}</p>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>

    <hr class="divider" />
  {% endif %}

  {% if designBytes | length %}
    <section>
      <div class="section-header">
        <p class="section-label">From Design Bytes</p>
        <a href="https://design-bytes.com" class="btn btn--secondary" target="_blank" rel="noopener">
          Visit Design Bytes
        </a>
      </div>
      <div class="l-grid">
        {% for post in designBytes %}
          <a class="post-card" href="{{ post.url }}" target="_blank" rel="noopener">
            {% if post.image %}
              <div class="post-card__image">
                <img src="{{ post.image }}" alt="{{ post.title }}" loading="lazy" />
              </div>
            {% else %}
              <div class="post-card__image post-card__image--placeholder"></div>
            {% endif %}
            <div class="post-card__body">
              {% if post.date %}
                <time class="post-card__date" datetime="{{ post.date | htmlDateString }}">
                  {{ post.date | readableDate }}
                </time>
              {% endif %}
              <h2 class="post-card__title">{{ post.title }}</h2>
              {% if post.summary %}
                <p class="post-card__summary">{{ post.summary }}</p>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      </div>
    </section>
  {% endif %}
</div>
